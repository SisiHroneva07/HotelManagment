@using Hotel.Web.Authorization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Velvet &amp; Vine</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/velvet-vine.css" asp-append-version="true" />
</head>
<body class="vv-body">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark vv-navbar py-2">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Velvet &amp; Vine</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#vvNav"
                        aria-controls="vvNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="vvNav">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Management
                                </a>
                                <ul class="dropdown-menu">
                                    @if (User.IsInRole(HotelRoles.Admin))
                                    {
                                        <li><a class="dropdown-item" asp-controller="StaffUsers" asp-action="Index">Staff</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Clients" asp-action="Index">Guests</a></li>
                                    <li><a class="dropdown-item" asp-controller="Rooms" asp-action="Index">Rooms</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reservations" asp-action="Index">Reservations</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-white-50">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link btn btn-link border-0 p-0 m-2" style="color: var(--vv-gold-light);">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container vv-main py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="vv-footer">
        <div class="container text-center">
            &copy; @DateTime.UtcNow.Year Velvet &amp; Vine — Hotel Reservations Manager
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
