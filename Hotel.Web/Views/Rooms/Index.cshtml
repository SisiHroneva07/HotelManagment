@model RoomIndexViewModel
@using Hotel.Web.Authorization
@{
    ViewData["Title"] = "Rooms";
    var isAdmin = User.IsInRole(HotelRoles.Admin);
}
<h1 class="vv-page-title">Rooms</h1>
<div class="vv-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Min capacity</label>
            <input name="minCapacity" class="form-control" type="number" min="1" value="@Model.MinCapacity" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Type</label>
            <select name="type" class="form-select" asp-items="Model.TypeOptions"></select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Availability</label>
            <select name="isFree" class="form-select" asp-items="Model.AvailabilityOptions"></select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Room #</label>
            <input name="roomNumber" class="form-control" value="@Model.RoomNumberFilter" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Page size</label>
            <input name="pageSize" class="form-control" type="number" value="@Model.Pager.PageSize" min="5" max="50" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-vv-primary w-100">Filter</button>
        </div>
    </form>
</div>
@if (isAdmin)
{
    <p><a asp-action="Create" class="btn btn-vv-primary">Add room</a></p>
}
<div class="table-responsive vv-card p-0">
    <table class="table table-striped vv-table mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Capacity</th>
                <th>Type</th>
                <th>Free</th>
                <th>Adult</th>
                <th>Child</th>
                @if (isAdmin)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rooms)
            {
                <tr>
                    <td>@r.RoomNumber</td>
                    <td>@r.Capacity</td>
                    <td>@r.Type</td>
                    <td>@(r.IsFree ? "Yes" : "No")</td>
                    <td>@r.PriceAdult.ToString("C")</td>
                    <td>@r.PriceChild.ToString("C")</td>
                    @if (isAdmin)
                    {
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-vv-outline">Edit</a>
                            <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-vv-danger">Delete</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Pager.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Pager.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Pager.Page - 1)"
                   asp-route-pageSize="@Model.Pager.PageSize"
                   asp-route-minCapacity="@Model.MinCapacity"
                   asp-route-type="@Model.Type"
                   asp-route-isFree="@Model.IsFree"
                   asp-route-roomNumber="@Model.RoomNumberFilter">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Pager.Page / @Model.Pager.TotalPages</span></li>
            <li class="page-item @(Model.Pager.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index"
                   asp-route-page="@(Model.Pager.Page + 1)"
                   asp-route-pageSize="@Model.Pager.PageSize"
                   asp-route-minCapacity="@Model.MinCapacity"
                   asp-route-type="@Model.Type"
                   asp-route-isFree="@Model.IsFree"
                   asp-route-roomNumber="@Model.RoomNumberFilter">Next</a>
            </li>
        </ul>
    </nav>
}
