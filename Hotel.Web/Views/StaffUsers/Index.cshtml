@model StaffUserIndexViewModel
@{
    ViewData["Title"] = "Staff";
}

<h1 class="vv-page-title">Staff accounts</h1>

<div class="vv-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <input type="hidden" name="page" value="1" />
        <div class="col-md-2">
            <label class="form-label">Page size</label>
            <select name="pageSize" class="form-select" onchange="this.form.submit()">
                <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                <option value="25" selected="@(Model.PageSize == 25 ? "selected" : null)">25</option>
                <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Username</label>
            <input name="userName" value="@Model.UserNameFilter" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Name</label>
            <input name="name" value="@Model.NameFilter" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Email</label>
            <input name="email" value="@Model.EmailFilter" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-vv-primary w-100">Filter</button>
        </div>
    </form>
</div>

<p>
    <a asp-action="Create" class="btn btn-vv-primary">Add staff</a>
</p>

<div class="table-responsive vv-card p-0">
    <table class="table table-striped vv-table mb-0">
        <thead>
            <tr>
                <th>Username</th>
                <th>Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td>@u.UserName</td>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@string.Join(", ", u.Roles)</td>
                    <td>@(u.IsActive && !u.DismissalDate.HasValue ? "Yes" : "No")</td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-vv-outline">Edit</a>
                        <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-vv-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Pager.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Pager.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Pager.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-userName="@Model.UserNameFilter" asp-route-name="@Model.NameFilter" asp-route-email="@Model.EmailFilter">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Pager.Page of @Model.Pager.TotalPages</span></li>
            <li class="page-item @(Model.Pager.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Pager.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-userName="@Model.UserNameFilter" asp-route-name="@Model.NameFilter" asp-route-email="@Model.EmailFilter">Next</a>
            </li>
        </ul>
    </nav>
}
