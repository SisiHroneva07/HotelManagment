@model ReservationIndexViewModel
@{
    ViewData["Title"] = "Reservations";
}
<h1 class="vv-page-title">Reservations</h1>
<div class="vv-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Room</label>
            <select name="roomId" class="form-select" asp-items="Model.Rooms"></select>
        </div>
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input name="from" class="form-control" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input name="to" class="form-control" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-vv-primary w-100">Filter</button>
        </div>
    </form>
</div>
<p><a asp-action="Create" class="btn btn-vv-primary">New reservation</a></p>
<div class="table-responsive vv-card p-0">
    <table class="table table-striped vv-table mb-0">
        <thead>
            <tr>
                <th>Room</th>
                <th>Staff</th>
                <th>Check-in</th>
                <th>Check-out</th>
                <th>Guests</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Reservations)
            {
                <tr>
                    <td>@r.RoomNumber</td>
                    <td>@r.StaffName</td>
                    <td>@r.CheckInDate.ToString("d")</td>
                    <td>@r.CheckOutDate.ToString("d")</td>
                    <td>@r.GuestCount</td>
                    <td>@r.TotalAmount.ToString("C")</td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-vv-outline">Edit</a>
                        <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-vv-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Pager.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Pager.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Pager.Page - 1)"
                   asp-route-roomId="@Model.RoomId" asp-route-from="@Model.From" asp-route-to="@Model.To">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Pager.Page / @Model.Pager.TotalPages</span></li>
            <li class="page-item @(Model.Pager.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Pager.Page + 1)"
                   asp-route-roomId="@Model.RoomId" asp-route-from="@Model.From" asp-route-to="@Model.To">Next</a>
            </li>
        </ul>
    </nav>
}
